fn raw_text(lang : String) -> String? {
  match lang {
    "af" => Some(af)
    "ar" => Some(ar)
    "bg" => Some(bg)
    "bn" => Some(bn)
    "ca" => Some(ca)
    "cs" => Some(cs)
    "cy" => Some(cy)
    "da" => Some(da)
    "de" => Some(de)
    "el" => Some(el)
    "en" => Some(en)
    "es" => Some(es)
    "et" => Some(et)
    "fa" => Some(fa)
    "fi" => Some(fi)
    "fr" => Some(fr)
    "gu" => Some(gu)
    "he" => Some(he)
    "hi" => Some(hi)
    "hr" => Some(hr)
    "hu" => Some(hu)
    "id" => Some(id)
    "it" => Some(it)
    "ja" => Some(ja)
    "kn" => Some(kn)
    "ko" => Some(ko)
    "lt" => Some(lt)
    "lv" => Some(lv)
    "mk" => Some(mk)
    "ml" => Some(ml)
    "mr" => Some(mr)
    "ne" => Some(ne)
    "nl" => Some(nl)
    "no" => Some(no)
    "pa" => Some(pa)
    "pl" => Some(pl)
    "pt" => Some(pt)
    "ro" => Some(ro)
    "ru" => Some(ru)
    "sk" => Some(sk)
    "sl" => Some(sl)
    "so" => Some(so)
    "sq" => Some(sq)
    "sv" => Some(sv)
    "sw" => Some(sw)
    "ta" => Some(ta)
    "te" => Some(te)
    "th" => Some(th)
    "tl" => Some(tl)
    "tr" => Some(tr)
    "uk" => Some(uk)
    "ur" => Some(ur)
    "vi" => Some(vi)
    "zh-cn" => Some(zh_cn)
    "zh-tw" => Some(zh_tw)
    _ => None
  }
}

pub fn profile(lang : String) -> Map[String, Int]? raise {
  let text = match raw_text(lang) {
    Some(t) => t
    None => return None
  }
  let out : Map[String, Int] = Map([])
  for line in text.split("\n") {
    if line.length() > 0 {
      let parts = line.split("\t").collect()
      out[parts[0].to_owned()] = @string.parse_int(parts[1])
    }
  }
  Some(out)
}

pub fn entry_count(lang : String) -> Int raise {
  match profile(lang) {
    Some(m) => m.length()
    None => -1
  }
}

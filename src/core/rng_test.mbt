///| V-31 / V-32 — MT19937 and Box-Muller parity with CPython 3.12.10.
///

///| Every expected value is copied as a big-endian IEEE-754 / 32-bit bit

///| pattern from `docs/port/golden/rand/*.json` (read-only evidence):

///| `gauss_stress.json` (512 values x seeds 0/1/42/12345 = 2,048),

///| `mt19937.json` (seeds 0/42 x 64 words), `random_double.json`

///| (seeds 0/42 x 64 doubles), `getrandbits.json` (k = 1/2/3/12/16/32/33,

///| 32 values each), `randbelow.json` (n = 1/2/3/5/7/55/1000, 32 each)

///| and `mixed_sequence.json` (seed 0: 7 gauss / 7 alpha / 357 choices

///| over a 667-element n-gram list).
///

///| The public `getrandbits` form is `Int` (32-bit signed), so the k = 32

///| and k = 33 goldens are checked through the 64-bit helper

///| `getrandbits_u64`; the `Int` form is separately checked for k <= 32

///| by comparing its raw bit pattern (see `getrandbits_int_form`).

///| `randbelow` always goes through the 64-bit helper.

///|
/// Parse one hex digit.
fn hex_digit(ch : Char) -> UInt64 {
  let code = ch.to_int()
  if code >= 0x30 && code <= 0x39 {
    (code - 0x30).to_uint64()
  } else if code >= 0x61 && code <= 0x66 {
    (code - 0x61 + 10).to_uint64()
  } else {
    (code - 0x41 + 10).to_uint64()
  }
}

///|
/// Decode 16 hex digits starting at `offset`.
fn hex16(raw : String, offset : Int32) -> UInt64 {
  let mut value = 0UL
  let mut index = 0
  while index < 16 {
    match raw.get_char(offset + index) {
      Some(ch) => value = (value << 4) | hex_digit(ch)
      None => ()
    }
    index += 1
  }
  value
}

///|
/// Split a concatenated hex string into 64-bit patterns.
fn hex_values(raw : String) -> Array[UInt64] {
  let values : Array[UInt64] = []
  let count = raw.char_length() / 16
  let mut index = 0
  while index < count {
    values.push(hex16(raw, index * 16))
    index += 1
  }
  values
}

///|
/// Count entries whose bit pattern differs from the expectation.
fn mismatch_count(actual : Array[UInt64], expected : Array[UInt64]) -> Int32 {
  let mut count = 0
  let mut index = 0
  while index < expected.length() {
    if actual[index] != expected[index] {
      count += 1
    }
    index += 1
  }
  count
}


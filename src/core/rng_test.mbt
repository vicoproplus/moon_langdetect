///| Count the bit-pattern mismatches of `rng.gauss(0, 1)` against a

///|
/// 512-value series.
fn gauss_mismatches(seed : Int64, raw : String) -> Int32 {
  let expected = hex_values(raw)
  if expected.length() != 512 {
    return -1
  }
  let rng = @core.Mt19937::new(Some(seed))
  let mut count = 0
  let mut index = 0
  while index < 512 {
    if rng.gauss(0.0, 1.0).reinterpret_as_uint64() != expected[index] {
      count += 1
    }
    index += 1
  }
  count
}

///|
test "gauss_stress_seed_0" {
  assert_eq(gauss_mismatches(0L, gauss_stress_seed0), 0)
}

///|
test "gauss_stress_seed_1" {
  assert_eq(gauss_mismatches(1L, gauss_stress_seed1), 0)
}

///|
test "gauss_stress_seed_42" {
  assert_eq(gauss_mismatches(42L, gauss_stress_seed42), 0)
}

///|
test "gauss_stress_seed_12345" {
  assert_eq(gauss_mismatches(12345L, gauss_stress_seed12345), 0)
}

///|
/// 64 raw 32-bit words per seed.
fn mt_mismatches(seed : Int64, raw : String) -> Int32 {
  let expected = hex_values(raw)
  if expected.length() != 64 {
    return -1
  }
  let rng = @core.Mt19937::new(Some(seed))
  let mut count = 0
  let mut index = 0
  while index < 64 {
    if rng.getrandbits_u64(32) != expected[index] {
      count += 1
    }
    index += 1
  }
  count
}

///|
test "mt19937_words_seed_0" {
  assert_eq(mt_mismatches(0L, mt19937_seed0), 0)
}

///|
test "mt19937_words_seed_42" {
  assert_eq(mt_mismatches(42L, mt19937_seed42), 0)
}

///|
/// 64 `random()` doubles per seed, compared by bit pattern.
fn random_mismatches(seed : Int64, raw : String) -> Int32 {
  let expected = hex_values(raw)
  if expected.length() != 64 {
    return -1
  }
  let rng = @core.Mt19937::new(Some(seed))
  let mut count = 0
  let mut index = 0
  while index < 64 {
    if rng.random().reinterpret_as_uint64() != expected[index] {
      count += 1
    }
    index += 1
  }
  count
}

///|
test "random_double_seed_0" {
  assert_eq(random_mismatches(0L, random_double_seed0), 0)
}

///|
test "random_double_seed_42" {
  assert_eq(random_mismatches(42L, random_double_seed42), 0)
}

///|
/// `getrandbits_u64(k)` against the 32-value series for k <= 64.
fn getrandbits_mismatches(k : Int32, raw : String) -> Int32 {
  let expected = hex_values(raw)
  if expected.length() != 32 {
    return -1
  }
  let rng = @core.Mt19937::new(Some(0L))
  let mut count = 0
  let mut index = 0
  while index < 32 {
    if rng.getrandbits_u64(k) != expected[index] {
      count += 1
    }
    index += 1
  }
  count
}

///|
test "getrandbits_k1" {
  assert_eq(getrandbits_mismatches(1, getrandbits_k1), 0)
}

///|
test "getrandbits_k2" {
  assert_eq(getrandbits_mismatches(2, getrandbits_k2), 0)
}

///|
test "getrandbits_k3" {
  assert_eq(getrandbits_mismatches(3, getrandbits_k3), 0)
}

///|
test "getrandbits_k12" {
  assert_eq(getrandbits_mismatches(12, getrandbits_k12), 0)
}

///|
test "getrandbits_k16" {
  assert_eq(getrandbits_mismatches(16, getrandbits_k16), 0)
}

///| k = 32 uses the 64-bit helper: the public `Int` form cannot carry

///|
/// unsigned values >= 2^31.
test "getrandbits_k32_via_u64_helper" {
  assert_eq(getrandbits_mismatches(32, getrandbits_k32), 0)
}

///|
/// k = 33 also uses the 64-bit helper (the `Int` form stops at 32).
test "getrandbits_k33_via_u64_helper" {
  assert_eq(getrandbits_mismatches(33, getrandbits_k33), 0)
}

///| The public `Int` form for k = 32 returns the same raw bit pattern;

///|
/// only the signed interpretation differs.
test "getrandbits_int_form" {
  let expected = hex_values(getrandbits_k32)
  let rng = @core.Mt19937::new(Some(0L))
  let mut count = 0
  let mut index = 0
  while index < 32 {
    if rng.getrandbits(32).reinterpret_as_uint().to_uint64() != expected[index] {
      count += 1
    }
    index += 1
  }
  assert_eq(count, 0)
}

///|
/// 32 `randbelow(n)` values per n, each from a fresh `Random(0)`.
fn randbelow_mismatches(n : Int32, expected : Array[Int32]) -> Int32 {
  if expected.length() != 32 {
    return -1
  }
  let rng = @core.Mt19937::new(Some(0L))
  let mut count = 0
  let mut index = 0
  while index < 32 {
    if rng.randbelow(n) != expected[index] {
      count += 1
    }
    index += 1
  }
  count
}

///|
test "randbelow_n1" {
  assert_eq(randbelow_mismatches(1, randbelow_n1), 0)
}

///|
test "randbelow_n2" {
  assert_eq(randbelow_mismatches(2, randbelow_n2), 0)
}

///|
test "randbelow_n3" {
  assert_eq(randbelow_mismatches(3, randbelow_n3), 0)
}

///|
test "randbelow_n5" {
  assert_eq(randbelow_mismatches(5, randbelow_n5), 0)
}

///|
test "randbelow_n7" {
  assert_eq(randbelow_mismatches(7, randbelow_n7), 0)
}

///|
test "randbelow_n55" {
  assert_eq(randbelow_mismatches(55, randbelow_n55), 0)
}

///|
test "randbelow_n1000" {
  assert_eq(randbelow_mismatches(1000, randbelow_n1000), 0)
}

///| V-31 — upstream `long-af` call order (seed 0): one `gauss` per

///| round, then `choice(ngrams)` `choice_counts_per_round` times, over a

///|
/// 667-element n-gram list. 7/7 gauss and 357/357 choice indices.
test "mixed_sequence_7_gauss_357_choices" {
  let gauss_bits = hex_values(mixed_GAUSS)
  let alpha_bits = hex_values(mixed_ALPHA)
  assert_eq(gauss_bits.length(), 7)
  assert_eq(alpha_bits.length(), 7)
  let ngrams = Array::make(667, "x")
  let rng = @core.Mt19937::new(Some(0L))
  let mut choice_index = 0
  let mut round = 0
  while round < 7 {
    let g = rng.gauss(0.0, 1.0)
    assert_eq(g.reinterpret_as_uint64(), gauss_bits[round])
    let alpha = 0.5 + g * @core.ALPHA_WIDTH
    assert_eq(alpha.reinterpret_as_uint64(), alpha_bits[round])
    let mut pick = 0
    while pick < mixed_CHOICE_COUNTS[round] {
      let index = rng.randbelow(ngrams.length())
      assert_eq(index, mixed_CHOICE[choice_index])
      choice_index += 1
      pick += 1
    }
    round += 1
  }
  assert_eq(choice_index, 357)
}

// ---------------------------------------------------------------------
// Streaming and seam behaviour
// ---------------------------------------------------------------------

///| Deterministic seed: five fresh generators produce identical

///|
/// `random()` + `gauss()` streams.
test "seeded_stream_repeatability_5x" {
  let mut baseline : Array[UInt64] = []
  let mut run = 0
  while run < 5 {
    let rng = @core.Mt19937::new(Some(42L))
    let stream : Array[UInt64] = []
    let mut index = 0
    while index < 16 {
      stream.push(rng.random().reinterpret_as_uint64())
      index += 1
    }
    index = 0
    while index < 16 {
      stream.push(rng.gauss(0.0, 1.0).reinterpret_as_uint64())
      index += 1
    }
    if run == 0 {
      baseline = stream
    } else {
      assert_eq(mismatch_count(stream, baseline), 0)
    }
    run += 1
  }
  assert_eq(baseline.length(), 32)
}

///| Unseeded construction is non-reproducible and never raises: ten

///|
/// fresh generators are all usable and at least two streams differ.
test "unseeded_stream_10x_no_exception" {
  let firsts : Array[UInt64] = []
  let mut run = 0
  while run < 10 {
    let rng = @core.Mt19937::new(None)
    firsts.push(rng.random().reinterpret_as_uint64())
    // Exercise the rest of the pipeline so a broken unseeded state
    // cannot hide behind one call.
    let _ = rng.gauss(0.0, 1.0)
    let _ = rng.randbelow(7)
    run += 1
  }
  assert_eq(firsts.length(), 10)
  let mut distinct = 0
  let mut i = 0
  while i < 10 {
    let mut j = 0
    let mut seen = false
    while j < i {
      if firsts[j] == firsts[i] {
        seen = true
      }
      j += 1
    }
    if !seen {
      distinct += 1
    }
    i += 1
  }
  assert_true(distinct > 1)
}

///| `gauss_with` replaces only the logarithm: a stub returning 0 makes

///|
/// `g2rad` 0, so both the fresh and the cached value are `mu`.
fn zero_ln(_x : Double) -> Double {
  0.0
}

///|
test "gauss_with_injection_seam" {
  let rng = @core.Mt19937::new(Some(0L))
  assert_eq(rng.gauss_with(2.0, 3.0, ln=zero_ln), 2.0)
  assert_eq(rng.gauss_with(2.0, 3.0, ln=zero_ln), 2.0)
}

///| The Box-Muller cache alternates fresh/cached values: pairs consume

///|
/// exactly the same random stream as two independent transforms would.
test "gauss_cache_contract" {
  let rng = @core.Mt19937::new(Some(0L))
  let first = rng.gauss(0.0, 1.0)
  let second = rng.gauss(0.0, 1.0)
  let reference = @core.Mt19937::new(Some(0L))
  let expected_first = reference.gauss(0.0, 1.0)
  let expected_second = reference.gauss(0.0, 1.0)
  assert_eq(
    first.reinterpret_as_uint64(),
    expected_first.reinterpret_as_uint64(),
  )
  assert_eq(
    second.reinterpret_as_uint64(),
    expected_second.reinterpret_as_uint64(),
  )
}

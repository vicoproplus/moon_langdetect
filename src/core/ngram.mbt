///| N-gram buffering and character normalization, ported from
///| `langdetect/langdetect/utils/ngram.py:23-260`.
///
///| Upstream `NGram.normalize` maps one codepoint to one codepoint. The
///| product signature is string-to-string and applies that map to every
///| codepoint of the input, so the upstream one-character test cases port
///| verbatim as one-character strings. `add_char` uses the same map through
///| the package-private `normalize_char`.
///
///| The data tables (`ngram_tables.mbt`) are generated by
///| `tools/gen_core_tables.py` and carry the 12 block constants, the
///| Latin-1 exclusion set, the 6667 sorted CJK pairs and the 120 sorted
///| Vietnamese triples.

///| Upstream `NGram.N_GRAM` (`ngram.py:25`): the buffer keeps at most three
///| codepoints.
pub const N_GRAM : Int = 3

///| The n-gram buffer state. `grams` starts as a single space (upstream
///| `__init__`); `capitalword` suppresses every feature of a run of
///| consecutive uppercase letters (quirk §10-7, V-46).
pub struct NGram {
  mut grams : String
  mut capitalword : Bool
}

///| An empty buffer: one space and no capital-word run.
pub fn NGram::new() -> NGram {
  { grams: " ", capitalword: false }
}

///| Binary search over the generated `cjk_pairs` (sorted by codepoint).
///| Returns the upstream `CJK_MAP` replacement, or `None` when the
///| codepoint is not a key (upstream `CJK_MAP.get(ch, ch)`).
fn lookup_cjk(codepoint : Int) -> Int? {
  let mut lo = 0
  let mut hi = cjk_pairs.length() - 1
  while lo <= hi {
    let mid = (lo + hi) / 2
    let (key, replacement) = cjk_pairs[mid]
    if codepoint < key {
      hi = mid - 1
    } else if codepoint > key {
      lo = mid + 1
    } else {
      return Some(replacement)
    }
  }
  None
}

///| Binary search over the generated `vi_triples` (sorted by
///| `(base, mark)`). Returns the `NORMALIZED_VI_CHARS[mark][base]`
///| replacement, or `None` when the pair is not a table entry.
fn lookup_vi(base : Int, mark : Int) -> Int? {
  let mut lo = 0
  let mut hi = vi_triples.length() - 1
  while lo <= hi {
    let mid = (lo + hi) / 2
    let (entry_base, entry_mark, replacement) = vi_triples[mid]
    if base < entry_base || (base == entry_base && mark < entry_mark) {
      hi = mid - 1
    } else if base > entry_base || (base == entry_base && mark > entry_mark) {
      lo = mid + 1
    } else {
      return Some(replacement)
    }
  }
  None
}

///| Convert an in-range codepoint from the generated tables to a `Char`.
///| Every constant and table entry is a valid Unicode scalar value, so a
///| failed conversion means the table data is corrupt: abort loudly rather
///| than silently substituting a space and changing normalization.
fn char_of(codepoint : Int) -> Char {
  match codepoint.to_char() {
    Some(ch) => ch
    None => abort("char_of: codepoint is not a valid Unicode scalar value")
  }
}

///| Per-codepoint upstream `NGram.normalize` (`ngram.py:64-97`), 12 block
///| constants in 11 decision arms (Bopomofo and Bopomofo Extended share
///| the ninth arm).
fn normalize_char(ch : Char) -> Char {
  let codepoint = ch.to_int()
  let block = @unicode.unicode_block(codepoint)
  if block == UNICODE_BASIC_LATIN {
    // Keep A-Z and a-z only; every other basic Latin codepoint becomes a
    // space (this also covers SPACE itself).
    if codepoint < 0x41 || (codepoint > 0x5A && codepoint < 0x61) || codepoint > 0x7A {
      ' '
    } else {
      ch
    }
  } else if block == UNICODE_LATIN_1_SUPPLEMENT {
    if latin1_excluded.contains_char(ch) {
      ' '
    } else {
      ch
    }
  } else if block == UNICODE_LATIN_EXTENDED_B {
    // Romanian: small s/t with comma below -> with cedilla.
    if codepoint == 0x0219 {
      char_of(0x015F)
    } else if codepoint == 0x021B {
      char_of(0x0163)
    } else {
      ch
    }
  } else if block == UNICODE_GENERAL_PUNCTUATION {
    ' '
  } else if block == UNICODE_ARABIC {
    // Farsi yeh -> Arabic yeh.
    if codepoint == 0x06CC {
      char_of(0x064A)
    } else {
      ch
    }
  } else if block == UNICODE_LATIN_EXTENDED_ADDITIONAL {
    if codepoint >= 0x1EA0 {
      char_of(0x1EC3)
    } else {
      ch
    }
  } else if block == UNICODE_HIRAGANA {
    char_of(0x3042)
  } else if block == UNICODE_KATAKANA {
    char_of(0x30A2)
  } else if block == UNICODE_BOPOMOFO || block == UNICODE_BOPOMOFO_EXTENDED {
    char_of(0x3105)
  } else if block == UNICODE_CJK_UNIFIED_IDEOGRAPHS {
    match lookup_cjk(codepoint) {
      Some(replacement) => char_of(replacement)
      None => ch
    }
  } else if block == UNICODE_HANGUL_SYLLABLES {
    char_of(0xAC00)
  } else {
    ch
  }
}

///| Upstream `NGram.normalize`, applied to every codepoint of `text`.
pub fn NGram::normalize(text : String) -> String {
  let buffer = StringBuilder()
  for ch in text.iter() {
    buffer.write_char(normalize_char(ch))
  }
  buffer.to_string()
}

///| Upstream `NGram.normalize_vi` (`ngram.py:99-120`): a listed base
///| alphabet character followed by one of the five diacritical marks is
///| replaced by its precomposed U+1Exx / Latin-1 form. The scan is
///| left-to-right and non-overlapping, matching the upstream global regex.
pub fn NGram::normalize_vi(text : String) -> String {
  let chars = text.to_array()
  let buffer = StringBuilder()
  let mut index = 0
  while index < chars.length() {
    if index + 1 < chars.length() {
      match lookup_vi(chars[index].to_int(), chars[index + 1].to_int()) {
        Some(replacement) => {
          buffer.write_char(char_of(replacement))
          index = index + 2
          continue
        }
        None => ()
      }
    }
    buffer.write_char(chars[index])
    index = index + 1
  }
  buffer.to_string()
}

///| Drop the first codepoint of `chars` (the upstream `grams[1:]` slide).
fn drop_first_char(chars : Array[Char]) -> String {
  let tail : Array[Char] = []
  let mut index = 1
  while index < chars.length() {
    tail.push(chars[index])
    index = index + 1
  }
  String::from_array(tail)
}

///| Last `n` codepoints of `chars` (the upstream `grams[-n:]` slice).
fn take_tail(chars : Array[Char], n : Int) -> String {
  let tail : Array[Char] = []
  let mut index = chars.length() - n
  while index < chars.length() {
    tail.push(chars[index])
    index = index + 1
  }
  String::from_array(tail)
}

///| Append one codepoint, mirroring `NGram.add_char` (`ngram.py:31-48`):
///| the character is normalized first; a space resets the buffer; the
///| buffer never exceeds `N_GRAM` codepoints; `capitalword` becomes true
///| when the current and the previous normalized characters are uppercase
///| and false otherwise (the upstream `if` leaves it untouched only when
///| the current character is uppercase and the previous one is not, which
///| is unreachable from a true state).
pub fn NGram::add_char(self : NGram, ch : Char) -> Unit {
  let normalized = normalize_char(ch)
  let chars = self.grams.to_array()
  let last_char = chars[chars.length() - 1]
  if last_char == ' ' {
    self.grams = " "
    self.capitalword = false
    if normalized == ' ' {
      return
    }
  } else if chars.length() >= N_GRAM {
    self.grams = drop_first_char(chars)
  }
  self.grams = self.grams + normalized.to_string()
  if @unicode.is_upper_cp312(normalized.to_int()) {
    if @unicode.is_upper_cp312(last_char.to_int()) {
      self.capitalword = true
    }
  } else {
    self.capitalword = false
  }
}

///| Upstream `NGram.get` (`ngram.py:50-62`): `None` for a capital-word
///| run, for `n` outside 1..3, when the buffer is shorter than `n`, and
///| for `n == 1` when the last codepoint is a space.
pub fn NGram::get(self : NGram, n : Int) -> String? {
  if self.capitalword {
    return None
  }
  if n < 1 || n > N_GRAM {
    return None
  }
  let chars = self.grams.to_array()
  if chars.length() < n {
    return None
  }
  if n == 1 {
    let ch = chars[chars.length() - 1]
    if ch == ' ' {
      return None
    }
    return Some(ch.to_string())
  }
  Some(take_tail(chars, n))
}

///| Package-private `capitalword` read for feature extraction.
fn NGram::is_capitalword(self : NGram) -> Bool {
  self.capitalword
}

///| Package-private raw tail of the buffer: `None` when the buffer is
///| shorter than `n`, otherwise the last `n` codepoints including spaces.
///| `extract_ngrams` needs this because the upstream extraction loop
///| tests the raw buffer length (`len(ngram.grams) < n`), not `get(n)`:
///| a space at n = 1 must not stop the n = 2 / 3 candidates.
fn NGram::raw_tail(self : NGram, n : Int) -> String? {
  if n < 1 || n > N_GRAM {
    return None
  }
  let chars = self.grams.to_array()
  if chars.length() < n {
    return None
  }
  Some(take_tail(chars, n))
}

///| 512-point golden comparison: `ln_for_gauss` must reproduce the libm `log`
///| bits recorded by CPython for every `ln_arg` point (512/512 on native).
test "ln_for_gauss_golden_512" {
  assert_eq(ln_golden_512.length(), 512)
  let mut matched = 0
  let mut first_mismatch = -1
  for i = 0; i < ln_golden_512.length(); i = i + 1 {
    let (arg_bits, want_bits) = ln_golden_512[i]
    let arg = arg_bits.reinterpret_as_double()
    let got = @math_seam.ln_for_gauss(arg)
    let got_bits = got.reinterpret_as_uint64()
    if got_bits == want_bits {
      matched = matched + 1
    } else if first_mismatch < 0 {
      first_mismatch = i
    }
  }
  inspect(matched, content="512")
  inspect(first_mismatch, content="-1")
}

///| A9 smoke test: the first real product-side call of `ln_for_gauss` must
///| return the IEEE-754 bit pattern of `ln(2.0)` (`0x3FE62E42FEFA39EF`).
///| Reference value: CPython 3.12 libm at 2.0 on win32 x64.
test "ln_for_gauss_bits" {
  let bits = @math_seam.ln_for_gauss(2.0).reinterpret_as_uint64()
  inspect(bits, content="4604418534313441775")
  assert_eq(bits, 0x3FE62E42FEFA39EFUL)
}

///| The injection seam only forwards `f(x)`; no numeric equivalence is
///| asserted here (that is the golden test's job).
test "ln_for_gauss_with_forwards" {
  let doubled = @math_seam.ln_for_gauss_with(f=fn(x) { x * 2.0 }, x=3.0)
  inspect(doubled.reinterpret_as_uint64(), content="4618441417868443648")
  let injected = @math_seam.ln_for_gauss_with(f=fn(_) { 42.0 }, x=2.0)
  inspect(injected.reinterpret_as_uint64(), content="4631107791820423168")
}
